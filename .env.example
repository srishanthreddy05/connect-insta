# ─── Meta App Credentials ──────────────────────────────────────────────────
APP_ID=your_meta_app_id
APP_SECRET=your_meta_app_secret
REDIRECT_URI=https://your-app.onrender.com/auth/callback
WEBHOOK_VERIFY_TOKEN=pick_a_random_strong_string_here

# ─── Database ───────────────────────────────────────────────────────────────
# Render PostgreSQL: copy from Render dashboard → your DB → Connection String
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─── Token Encryption ───────────────────────────────────────────────────────
# AES-256 key for encrypting stored page access tokens
# Generate with: openssl rand -hex 32
# NEVER commit this to git
ENCRYPTION_KEY=64_char_hex_string_here

# ─── Admin API ──────────────────────────────────────────────────────────────
# Used by X-Api-Key header to protect dashboard/admin routes
ADMIN_API_KEY=pick_a_long_random_string_here

# ─── App ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

// prisma/schema.prisma
enum TriggerType {
  COMMENT
  DM
}
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ConnectedAccount {
  id                 String    @id @default(cuid())
  userId             String
  instagramId        String    @unique
  instagramUsername  String?
  accessToken        String
  tokenExpiresAt     DateTime?
  connectedAt        DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  isActive           Boolean   @default(true)
  mediaLastSyncedAt  DateTime?
  missingPermissions String[]  @default([])

  automations Automation[]
  media       InstagramMedia[]

  @@index([userId])
  @@map("connected_accounts")
}
model Automation {
  id              String    @id @default(cuid())
  userId          String
  instagramId     String
  name            String
  keywords        String[]
  matchType       MatchType @default(CONTAINS)
  responseMessage String
  triggerType     TriggerType @default(COMMENT)   // ← ADD
  flowSteps       Json?                            // ← ADD
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  applyToAllPosts      Boolean   @default(true)
  enableCommentReply   Boolean   @default(false)
  commentReplyMessage  String?
  triggerCount         Int       @default(0)
  commentsRepliedCount Int       @default(0)
  dmsSentCount         Int       @default(0)
  openingMessage       String?
  lastError            String?

  connectedAccount ConnectedAccount @relation(fields: [instagramId], references: [instagramId])
  selectedMedia    InstagramMedia[]
  messages         AutomationMessage[]

  @@index([userId])
  @@index([instagramId])
  @@map("automations")
}

model AutomationMessage {
  id           String     @id @default(cuid())
  automationId String
  message      String
  order        Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId])
  @@map("automation_messages")
}

model InstagramMedia {
  id          String   @id @default(cuid())
  mediaId     String   @unique
  instagramId String
  caption     String?
  mediaType   String   // REELS, IMAGE, VIDEO
  mediaUrl    String?
  timestamp   DateTime

  connectedAccount ConnectedAccount @relation(fields: [instagramId], references: [instagramId], onDelete: Cascade)
  automations      Automation[]

  @@index([instagramId])
  @@map("instagram_media")
}
model ConversationState {
  id          String   @id @default(cuid())
  instagramId String
  recipientId String
  state       String
  flowData    Json?    // stores current position in the flow
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([instagramId, recipientId])
  @@map("conversation_states")
}

model WebhookEvent {
  id          String    @id @default(cuid())
  instagramId String
  eventType   String
  eventId     String    @unique
  payload     Json
  processed   Boolean   @default(false)
  error       String?
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([instagramId])
  @@index([processed])
  @@map("webhook_events")
}

model SentDm {
  id                String   @id @default(cuid())
  instagramId       String
  recipientId       String
  automationId      String
  messageText       String
  metaMessageId     String?
  messageType       String   @default("COMMENT_REPLY")
  externalMessageId String   @default("")
  sentAt            DateTime @default(now())

  @@unique([instagramId, recipientId, messageType, externalMessageId])
  @@map("sent_dms")
}

enum MatchType {
  EXACT
  CONTAINS
  STARTS_WITH
}
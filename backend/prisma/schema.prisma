// prisma/schema.prisma
enum TriggerType {
  COMMENT
  DM
}
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ConnectedAccount {
  id                String    @id @default(cuid())
  userId            String
  instagramId       String    @unique
  instagramUsername String?
  accessToken       String
  tokenExpiresAt    DateTime?
  connectedAt       DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  isActive          Boolean   @default(true)

  automations Automation[]

  @@index([userId])
  @@map("connected_accounts")
}
model Automation {
  id              String    @id @default(cuid())
  userId          String
  instagramId     String
  name            String
  keywords        String[]
  matchType       MatchType @default(CONTAINS)
  responseMessage String
  triggerType     TriggerType @default(COMMENT)   // ← ADD
  flowSteps       Json?                            // ← ADD
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  connectedAccount ConnectedAccount @relation(fields: [instagramId], references: [instagramId])

  @@index([userId])
  @@index([instagramId])
  @@map("automations")
}
model ConversationState {
  id          String   @id @default(cuid())
  instagramId String
  recipientId String
  state       String
  flowData    Json?    // stores current position in the flow
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([instagramId, recipientId])
  @@map("conversation_states")
}

model WebhookEvent {
  id          String    @id @default(cuid())
  instagramId String
  eventType   String
  eventId     String    @unique
  payload     Json
  processed   Boolean   @default(false)
  error       String?
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([instagramId])
  @@index([processed])
  @@map("webhook_events")
}

model SentDm {
  id            String   @id @default(cuid())
  instagramId   String
  recipientId   String
  automationId  String
  messageText   String
  metaMessageId String?
  sentAt        DateTime @default(now())

  @@unique([instagramId, recipientId, automationId])
  @@map("sent_dms")
}

enum MatchType {
  EXACT
  CONTAINS
  STARTS_WITH
}
// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ConnectedAccount {
  id                String   @id @default(cuid())
  userId            String
  pageId    String?  @unique
pageName  String?
  instagramId       String   @unique
  instagramUsername String?
  pageAccessToken   String
  userAccessToken   String?  // ✅ add this
    webhookInstagramId String?  
  connectedAt       DateTime @default(now())
  updatedAt         DateTime @updatedAt
  isActive          Boolean  @default(true)

  automations Automation[]

  @@index([userId])
  @@map("connected_accounts")
}

model Automation {
  id              String    @id @default(cuid())
  userId          String
  instagramId     String
  name            String
  keywords        String[]
  matchType       MatchType @default(CONTAINS)
  responseMessage String
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  connectedAccount ConnectedAccount @relation(fields: [instagramId], references: [instagramId])

  @@index([userId])
  @@index([instagramId])
  @@map("automations")
}

model WebhookEvent {
  id          String    @id @default(cuid())
  instagramId String
  eventType   String
  eventId     String    @unique
  payload     Json
  processed   Boolean   @default(false)
  error       String?
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([instagramId])
  @@index([processed])
  @@map("webhook_events")
}

model SentDm {
  id            String   @id @default(cuid())
  instagramId   String
  recipientId   String
  automationId  String
  messageText   String
  metaMessageId String?
  sentAt        DateTime @default(now())

  @@unique([instagramId, recipientId, automationId])
  @@map("sent_dms")
}

enum MatchType {
  EXACT
  CONTAINS
  STARTS_WITH
}